# Environment of the portfolio API on the server. Copy to .env and edit. Never commit the real file.
# Every setting the app reads is listed here, with its default where it has one. The Neon owner URL
# (migrations) and the retention URL are NOT here: migrations run from a developer machine, and
# the retention job has its own file (.env.retention).

# Image to run: the one published by .github/workflows/deploy-api.yml. To go back to an earlier
# version, set it to the tag of that commit: ghcr.io/<your-github-user>/portfolio-api:sha-<commit>
API_IMAGE=ghcr.io/<your-github-user>/portfolio-api:latest

# "production" turns off /docs and /openapi.json and rejects unsafe CORS origins.
ENVIRONMENT=production
# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# JSON list of the portfolio origins. In production only explicit https origins are accepted.
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
# Requests with a bigger body are rejected with 413. Caddy cuts at 64 KB before this.
MAX_BODY_BYTES=16384
# Public address of the portfolio, no trailing slash. Answers may link to it.
SITE_URL=https://yourdomain.com

# Neon, application role portfolio_app (SELECT and INSERT only), direct host (no "-pooler" in the
# name). sslmode=require is needed: psycopg defaults to "prefer".
DATABASE_URL=postgresql+psycopg://portfolio_app:<password>@<neon-direct-host>/portfolio?sslmode=require

# Groq is the main provider. The four values marked required stop the app from starting if empty.
# Required.
GROQ_API_KEY=
# Required.
GROQ_MODEL=openai/gpt-oss-120b
# Required: the Prompt Guard classifier on the same Groq account.
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# Required: random string that detects a leaked prompt. Generate once and keep it stable:
# python -c "import secrets; print('CANARY-' + secrets.token_hex(8))"
CANARY_TOKEN=
# Gemini is the fallback. Never used for the EU, EEA, UK, Switzerland or an unknown country.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Low temperature keeps answers close to the knowledge file.
LLM_TEMPERATURE=0.3
# Includes the model's hidden reasoning; real answers use about 150.
LLM_MAX_OUTPUT_TOKENS=800
# Prompt Guard score from which a message is blocked.
GUARD_THRESHOLD=0.8

# Kill switch: false makes the chat answer 503 assistant_paused.
CHAT_ENABLED=true
# Keep false while the API host is DNS only in Cloudflare: the country header could be faked, so
# Gemini is never used and the chat depends on Groq's quota (see docs/deploy.md).
TRUST_CLOUDFLARE_HEADERS=false
# Per visitor (an IPv4 address or an IPv6 /56 block).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=30
# Questions that reach a model, per visitor. Quick buttons, cached answers and refusals do not
# count. The counters stay in memory, so a deploy resets them.
MODEL_CALLS_PER_VISITOR_HOUR=3
MODEL_CALLS_PER_VISITOR_DAY=6
# Tokens a day, all visitors together, before the assistant pauses. Resets at midnight UTC. Groq's
# free tier allows about 200,000; the rest is for evals and manual tests. The count survives
# deploys (state file in the api_state volume).
DAILY_TOKEN_BUDGET=150000
# A repeated question is answered from memory without a model call. 0 seconds switches it off.
ANSWER_CACHE_TTL_SECONDS=86400
ANSWER_CACHE_MAX_ENTRIES=500

# Time limits for every external call, in seconds.
GUARD_TIMEOUT_SECONDS=3
GROQ_TIMEOUT_SECONDS=12
GEMINI_TIMEOUT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=25
