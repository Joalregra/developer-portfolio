# Environment of the retention job only. Copy to .env.retention and edit. Never commit the real file.
# The job runs `python -m app.jobs.purge_chat_log` once a day from cron. It is the only thing that
# can delete log rows, and it gets none of the API's keys.

# Neon, role portfolio_retention (SELECT and DELETE only), direct host (no "-pooler").
RETENTION_DATABASE_URL=postgresql+psycopg://portfolio_retention:<password>@<neon-direct-host>/portfolio?sslmode=require
# Rows older than this many days are deleted.
CHAT_LOG_RETENTION_DAYS=90
