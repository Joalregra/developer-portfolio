# URL of the FastAPI backend (public: every VITE_ variable ends up in the browser bundle).
# In production both variables are build variables of the Cloudflare project (docs/deploy.md).
# VITE_API_URL also goes into the Content-Security-Policy, so the build stops on Cloudflare without it.
VITE_API_URL=http://localhost:8000

# Public origin of the deployed site, no trailing slash. Enables canonical, hreflang,
# absolute Open Graph URLs and sitemap.xml at build time. Leave empty in development.
VITE_SITE_URL=
