# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development

# Frontend origins allowed by CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# LLM providers for the portfolio assistant (backend only, never in the frontend)
GROQ_API_KEY=
GEMINI_API_KEY=

# PostgreSQL (Neon in production, docker-compose locally)
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
