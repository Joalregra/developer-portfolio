# Copy to .env and fill in real values. Never commit .env.
# GROQ_API_KEY, GROQ_MODEL, GUARD_MODEL and CANARY_TOKEN are required unless CHAT_ENABLED=false: the
# app does not start without them. Every other value has a default in app/core/config.py that
# works for local development. Production values: deploy/api/.env.example.
# "production" turns off /docs and /openapi.json and rejects unsafe CORS origins.
ENVIRONMENT=development
# Name shown in the API metadata. The default is fine.
# APP_NAME="Johan Rendon Portfolio API"
LOG_LEVEL=INFO

# Frontend origins allowed by CORS (JSON list). In production, only the portfolio domain.
CORS_ORIGINS=["http://localhost:5173"]
# Requests with a bigger body are rejected with 413.
MAX_BODY_BYTES=16384

# PostgreSQL (Neon in production, docker-compose locally).
# DATABASE_URL: the app user, which can only INSERT and SELECT. See backend/sql/roles.sql.
# MIGRATION_DATABASE_URL: the owner, used only by Alembic. Falls back to DATABASE_URL.
# In production use the direct Neon host (no "-pooler") and append ?sslmode=require to all three
# URLs (psycopg defaults to "prefer").
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio
MIGRATION_DATABASE_URL=
# RETENTION_DATABASE_URL: the user portfolio_retention (SELECT and DELETE only, see
# backend/sql/retention_role.sql). Only the job `python -m app.jobs.purge_chat_log` reads it.
RETENTION_DATABASE_URL=
CHAT_LOG_RETENTION_DAYS=90

# LLM providers for the portfolio assistant (backend only, never in the frontend)
GROQ_API_KEY=
GEMINI_API_KEY=
# Check the free tier and the availability of each model before choosing it.
GROQ_MODEL=
GEMINI_MODEL=
GUARD_MODEL=
# Sampling temperature, the answer limit in tokens (reasoning included) and the Prompt Guard
# score from which a message is blocked. The defaults are fine.
# LLM_TEMPERATURE=0.3
# LLM_MAX_OUTPUT_TOKENS=800
# GUARD_THRESHOLD=0.8
# Folder with the knowledge files. The default is backend/knowledge.
# KNOWLEDGE_DIR=
# Random string put in the system prompt to detect leaks. Generate one and keep it stable:
#   python -c "import secrets; print('CANARY-' + secrets.token_hex(8))"
CANARY_TOKEN=
# Public address of the portfolio (no trailing slash). Answers may link to it.
SITE_URL=
# Trust the CF-IPCountry header only when the API is really behind Cloudflare. In production the
# API host is DNS only, so keep false: Gemini is then never used.
TRUST_CLOUDFLARE_HEADERS=false
# Production only, read by uvicorn and not by the app: the address the proxy connects from (the
# shared Caddy on the Docker network). deploy/api/docker-compose.yml sets it. Without it every
# visitor looks like the proxy and shares one rate limit.
# FORWARDED_ALLOW_IPS=172.30.0.10

# Limits for the public chat endpoint
CHAT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=30
DAILY_LLM_BUDGET=300
# A repeated question is answered from memory for this long, without a model call. 0 = off.
ANSWER_CACHE_TTL_SECONDS=86400
ANSWER_CACHE_MAX_ENTRIES=500

# Time limits for external calls, in seconds
GUARD_TIMEOUT_SECONDS=3
GROQ_TIMEOUT_SECONDS=12
GEMINI_TIMEOUT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=25
